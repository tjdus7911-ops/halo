<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose 테마(HaloColors)와 같은 바탕색: 앱이 뜰 때 흰 화면이 번쩍이지 않게 -->
    <color name="halo_bg">#0A1220</color>
    <color name="halo_accent">#5BD8FF</color>

    <style name="Theme.Halo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/halo_bg</item>
        <item name="android:statusBarColor">@color/halo_bg</item>
        <item name="android:navigationBarColor">@color/halo_bg</item>
        <item name="android:colorAccent">@color/halo_accent</item>
    </style>
</resources>
